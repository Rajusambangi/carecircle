# Hindsight — Cloud (https://ui.hindsight.vectorize.io → API keys) or local (http://localhost:8888)
# Copy the exact API URL shown in the Hindsight Cloud dashboard.
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=carecircle-sharma

# Groq (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Local fallback when Groq is missing, rate-limited or down (ollama pull llama3.2)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Care-circle dataset (patient, caregivers, doctors, history), relative to backend/
CIRCLE_DATA=data/sharma_family.json

# Comma-separated origins allowed to call the API (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173,http://localhost:5175


